{
  "name": "wordpress-saas-dashboard",
  "description": "WordPress SaaS Dashboard - React application for managing WordPress sites",
  "type": "application",
  "framework": "static",
  "build": {
    "command": "npm run build",
    "directory": "./dist"
  },
  "environment": {
    "NODE_ENV": "production",
    "VITE_APP_ENV": "production"
  },
  "domains": [],
  "ports": [
    {
      "internal": 80,
      "external": 3000,
      "protocol": "http"
    }
  ],
  "healthcheck": {
    "path": "/health",
    "interval": 30,
    "timeout": 10,
    "retries": 3
  },
  "resources": {
    "limits": {
      "memory": "512M",
      "cpu": "0.5"
    }
  }
}